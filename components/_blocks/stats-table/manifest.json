{
  "name": "stats-table",
  "displayName": "Stats table",
  "description": "Variable rows of key/value stats.",
  "files": [
    { "src": "StatsTable.tsx", "dest": "components/_blocks/stats-table/StatsTable.tsx" },
    { "src": "StatsTable.module.scss", "dest": "components/_blocks/stats-table/StatsTable.module.scss" }
  ],
  "packages": [],
  "envVars": [],
  "cspPatch": {},
  "settings": {
    "count": { "kind": "number", "min": 1, "max": 6, "default": 3 },
    "style": { "kind": "enum", "of": ["plain", "iconified"], "default": "plain" }
  },
  "capeBindings": {
    "rows": "{pageType}.stats | array | stat labels"
  },
  "usableOn": ["result"]
}
