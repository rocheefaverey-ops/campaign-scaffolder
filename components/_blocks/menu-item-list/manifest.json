{
  "name": "menu-item-list",
  "displayName": "Menu item list",
  "description": "Vertical menu item list.",
  "files": [
    { "src": "MenuItemList.tsx", "dest": "components/_blocks/menu-item-list/MenuItemList.tsx" },
    { "src": "MenuItemList.module.scss", "dest": "components/_blocks/menu-item-list/MenuItemList.module.scss" }
  ],
  "packages": [],
  "envVars": [],
  "cspPatch": {},
  "settings": {
    "items": { "kind": "array-of-enum", "of": ["home", "resume", "howToPlay", "leaderboard", "voucher", "terms", "privacy", "faq", "leave"], "default": ["home", "howToPlay", "terms", "privacy", "leave"] },
    "targets": { "kind": "item-target-map", "default": {} }
  },
  "capeBindings": {
    "labels": "{pageType}.items | array | menu item labels"
  },
  "usableOn": ["menu"]
}
