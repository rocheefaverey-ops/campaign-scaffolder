{
  "name": "cta-group",
  "displayName": "CTA group",
  "description": "1–4 stacked buttons. Edit each button's style and destination here — labels come from CAPE.",
  "files": [
    { "src": "CtaGroup.tsx", "dest": "components/_blocks/cta-group/CtaGroup.tsx" },
    { "src": "CtaGroup.module.scss", "dest": "components/_blocks/cta-group/CtaGroup.module.scss" }
  ],
  "packages": [],
  "envVars": [],
  "cspPatch": {},
  "settings": {
    "buttons": {
      "kind": "array-of-objects",
      "min": 1,
      "max": 4,
      "default": [{ "variant": "primary", "exit": "" }],
      "item": {
        "variant": { "kind": "enum", "of": ["primary", "secondary", "tertiary", "dark", "danger", "icon-only"], "default": "primary" },
        "exit": { "kind": "page-ref", "default": "" }
      }
    }
  },
  "capeBindings": {
    "labels": "{pageType}.cta | array | per-button labels"
  },
  "usableOn": ["landing", "result", "leaderboard", "voucher", "end", "menu"]
}
